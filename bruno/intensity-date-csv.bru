meta {
  name: Intensité date — export CSV (national)
  type: http
  seq: 47
}

get {
  url: {{baseUrl}}/v1/intensity/date?from=2024-01-01T00:00:00Z&to=2024-01-02T00:00:00Z&format=csv
  body: none
  auth: none
}

params:query {
  from: 2024-01-01T00:00:00Z
  to: 2024-01-02T00:00:00Z
  format: csv
}

docs {
  Même plage que « Intensité date — historique (national) », en CSV :
  `format=csv` (ou l'en-tête `Accept: text/csv`, qui revient au même ;
  `format` prime sur `Accept`). Réponse `text/csv; charset=utf-8` en pièce
  jointe (`Content-Disposition`), écrite en flux : une ligne d'en-tête
  `timestamp,intensity,unit,region,methodology,vintage` puis une ligne par
  mesure. Nécessite que l'historique ait été backfillé
  (`carbonfr-server backfill`).
}

assert {
  res.status: eq 200
  res.body: contains timestamp,intensity,unit,region,methodology,vintage
}
